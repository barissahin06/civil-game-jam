{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["format_version", "note", "areas"],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "areas": {
      "type": "array",
      "minItems": 21,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "region",
          "population",
          "base_income",
          "base_upkeep",
          "resilience",
          "damage",
          "teams",
          "total_teams",
          "stock",
          "province_ids",
          "completed_measures",
          "latitude",
          "longitude"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 81
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "enum": [
              "Marmara",
              "Ege",
              "İç Anadolu",
              "Akdeniz",
              "Karadeniz",
              "Doğu Anadolu",
              "Güneydoğu Anadolu"
            ]
          },
          "population": {
            "type": "integer",
            "minimum": 1
          },
          "base_income": {
            "type": "integer",
            "minimum": 0
          },
          "base_upkeep": {
            "type": "integer",
            "minimum": 0
          },
          "resilience": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "damage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "teams": {
            "type": "integer",
            "minimum": 0
          },
          "total_teams": {
            "type": "integer",
            "minimum": 0
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "province_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 81,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 81
            }
          },
          "completed_measures": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "additionalProperties": false
      },
      "maxItems": 21
    }
  }
}
