{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "note", "events"],
  "properties": {
    "format_version": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "minItems": 99,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "date",
          "kind",
          "description",
          "province_ids",
          "severity",
          "response_window_days",
          "reference_casualties"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^historical-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "kind": {
            "enum": ["earthquake", "flood", "fire", "avalanche", "landslide"]
          },
          "description": {
            "type": "string"
          },
          "province_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 81
            }
          },
          "severity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "response_window_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "reference_casualties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
