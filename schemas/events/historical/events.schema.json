{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tarihsel afet kayıtları",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "time",
      "disaster_type",
      "description",
      "casualties",
      "duration",
      "regions",
      "city",
      "is_active"
    ],
    "properties": {
      "name": { "$ref": "#/$defs/nonEmptyString" },
      "time": { "type": "string", "format": "date" },
      "disaster_type": {
        "enum": ["earthquake", "landslide", "flood", "avalanche", "wildfire"]
      },
      "description": { "$ref": "#/$defs/nonEmptyString" },
      "casualties": { "type": "integer", "minimum": 0 },
      "duration": { "type": "integer", "minimum": 1 },
      "regions": { "$ref": "#/$defs/stringList" },
      "city": { "$ref": "#/$defs/stringList" },
      "is_active": { "type": "boolean" },
      "aftermath": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actions"],
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "description", "sources"],
              "properties": {
                "type": { "enum": ["decision", "measure", "organization"] },
                "description": { "$ref": "#/$defs/nonEmptyString" },
                "sources": { "$ref": "#/$defs/sources" }
              }
            }
          },
          "research_note": { "$ref": "#/$defs/nonEmptyString" },
          "research_sources": { "$ref": "#/$defs/sources" }
        },
        "allOf": [
          {
            "if": { "properties": { "actions": { "maxItems": 0 } } },
            "then": { "required": ["research_note"] }
          },
          {
            "if": { "required": ["research_sources"] },
            "then": { "required": ["research_note"] }
          }
        ]
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://\\S+$" }
    }
  }
}
