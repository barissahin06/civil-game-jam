{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Afet sonrası tarihsel karar ve önlemler",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "note", "default_research_note", "entries"],
  "properties": {
    "format_version": { "const": 1 },
    "note": { "$ref": "#/$defs/text" },
    "default_research_note": { "$ref": "#/$defs/text" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "actions"],
        "properties": {
          "event_id": { "type": "string", "pattern": "^historical-[0-9]{3}$" },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "description", "sources"],
              "properties": {
                "type": { "enum": ["decision", "measure", "organization"] },
                "description": { "$ref": "#/$defs/text" },
                "sources": { "$ref": "#/$defs/sources" }
              }
            }
          },
          "research_note": { "$ref": "#/$defs/text" },
          "research_sources": { "$ref": "#/$defs/sources" }
        },
        "allOf": [
          {
            "if": { "properties": { "actions": { "maxItems": 0 } } },
            "then": { "required": ["research_note"] }
          },
          {
            "if": { "required": ["research_sources"] },
            "then": { "required": ["research_note"] }
          }
        ]
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://\\S+$" }
    }
  }
}
