extends GdUnitTestSuite


func test_guest_team_keeps_home_and_returns_home_after_local_crisis() -> void:
	var sim := Simulation.new()
	assert_bool(sim.setup()).is_true()
	var cash := sim.treasury.money
	var preview := sim.transfer_preview(34, 31, "team", 1)
	assert_int(preview.days).is_equal(3)
	assert_int(preview.fee).is_equal(150000)
	assert_bool(sim.transfer_resources(34, 31, "team", 1).ok).is_true()
	assert_bool(sim.transfer_resources(34, 31, "team", 1).ok).is_false()
	assert_int(sim.areas[34].total_teams).is_equal(1)
	sim.advance_to(sim.clock.day + 3)
	assert_int(sim.logistics.available_teams(31, 34)).is_equal(1)
	assert_int(sim.areas[31].teams).is_equal(1)
	assert_int(sim.unit_overview().summary.ready).is_equal(21)
	assert_int(sim.unit_overview().summary.total).is_equal(21)
	assert_int(sim.treasury.money).is_equal(cash - 150000)
	sim.advance_to(CalendarClock.date_to_day("1951-04-08"))
	sim.acknowledge()
	var crisis: Dictionary = sim.crises.active.front()
	preview = sim.dispatch_preview(31, crisis.id, "team", 1, 34)
	assert_int(preview.days).is_equal(0)
	assert_int(preview.return_days).is_equal(3)
	assert_int(preview.fee).is_equal(150000)
	assert_bool(sim.dispatch(31, crisis.id, "team", 1, 34).ok).is_true()
	assert_bool(sim.dispatch(31, crisis.id, "team", 1, 34).ok).is_false()
	assert_int(sim.logistics.stationed.size()).is_equal(0)
	var end_day := int(crisis.start) + int(crisis.window)
	sim.advance_to(end_day)
	assert_int(sim.unit_overview().summary.returning).is_equal(1)
	sim.acknowledge()
	sim.advance_to(end_day + 3)
	assert_int(sim.areas[34].teams).is_equal(1)
	assert_int(sim.areas[31].teams).is_equal(1)
	assert_int(sim.unit_overview().summary.ready).is_equal(21)


func test_recall_and_aid_transfer_preserve_inventory_without_a_crisis() -> void:
	var sim := Simulation.new()
	assert_bool(sim.setup()).is_true()
	assert_bool(sim.transfer_resources(34, 31, "team", 1).ok).is_true()
	assert_bool(sim.transfer_resources(1, 31, "stock", 20).ok).is_true()
	sim.advance_to(sim.clock.day + 3)
	assert_int(sim.areas[31].stock).is_equal(60)
	assert_int(sim.unit_overview().summary.stock).is_equal(840)
	assert_bool(sim.recall_teams(31, 34, 1).ok).is_true()
	assert_bool(sim.recall_teams(31, 34, 1).ok).is_false()
	sim.advance_to(sim.clock.day + 3)
	assert_int(sim.areas[34].teams).is_equal(1)
	assert_int(sim.logistics.stationed.size()).is_equal(0)
	assert_int(sim.unit_overview().summary.total).is_equal(21)


func test_transfer_preview_is_read_only_and_invalid_orders_do_not_spend() -> void:
	var sim := Simulation.new()
	assert_bool(sim.setup()).is_true()
	var before := JSON.stringify(sim.to_dict())
	sim.transfer_preview(34, 31, "team", 1)
	sim.logistics.ready_groups(34)
	assert_bool(sim.transfer_resources(34, 34, "team", 1).ok).is_false()
	assert_bool(sim.transfer_resources(999, 31, "stock", 1).ok).is_false()
	assert_bool(sim.transfer_resources(34, 31, "stock", 0).ok).is_false()
	assert_bool(sim.recall_teams(31, 34, 1).ok).is_false()
	assert_str(JSON.stringify(sim.to_dict())).is_equal(before)
